  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "socket.io-client": "^4.8.3"
  },
  "optionalDependencies": {
    "sharp": "0.35.4"
  }
}
